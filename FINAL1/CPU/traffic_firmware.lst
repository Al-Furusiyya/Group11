; Lab4 CPU relay. CPU addresses are WORD addresses.
; Input 0x3C0..3CF -> display staging 0x3D0..3DF.
; PS/2 events also pass through the CPU.
000: F803    LUI R8, 0x03
001: 28E0    ORI R8, 0xe0
002: F903    LUI R9, 0x03
003: 29E1    ORI R9, 0xe1
004: FA03    LUI R10, 0x03
005: 2AE2    ORI R10, 0xe2
006: FB03    LUI R11, 0x03
007: 2BE3    ORI R11, 0xe3
008: FC03    LUI R12, 0x03
009: 2CE4    ORI R12, 0xe4
00A: FD03    LUI R13, 0x03
00B: 2DE5    ORI R13, 0xe5
00C: DE01    MOVI R14, 0x01
poll:
00D: 400B    LOAD R0, [R11]
00E: B000    CMPI R0, 0
00F: C002    BEQ poll_packet
010: 400C    LOAD R0, [R12]
011: 404D    STOR R0, [R13]
poll_packet:
012: 4008    LOAD R0, [R8]
013: B000    CMPI R0, 0
014: C0F8    BEQ poll
015: F103    LUI R1, 0x03
016: 21C0    ORI R1, 0xc0
017: F203    LUI R2, 0x03
018: 22D0    ORI R2, 0xd0
019: D310    MOVI R3, 0x10
copy:
01A: 4001    LOAD R0, [R1]
01B: 4042    STOR R0, [R2]
01C: 6101    ADDUI R1, 1
01D: 6201    ADDUI R2, 1
01E: 63FF    ADDUI R3, -1
01F: B300    CMPI R3, 0
020: C1F9    BNE copy
021: 4E4A    STOR R14, [R10]
wait_frame:
022: 4009    LOAD R0, [R9]
023: B000    CMPI R0, 0
024: C1FD    BNE wait_frame
025: CEE7    BUC poll
