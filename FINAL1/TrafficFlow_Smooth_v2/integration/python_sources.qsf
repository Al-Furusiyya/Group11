# Existing-project integration: all HDL needed for Python + Lab4 CPU + VGA.
set cpu_jtag_root [file normalize [file join [file dirname [info script]] ..]]
set_global_assignment -name TOP_LEVEL_ENTITY demo_VGA_Python
foreach file_name {demo_VGA_Python.v vga_scene.v vga_timing.v sprite_smoother.v PS2Keyboard.v PS2Receiver.v PS2KeyDecoder.v KeyboardCommands.v JTAG/virtual_jtag_port.v JTAG/jtag_display_link.v CPU/CPU_Part1.v CPU/CPUControl.v CPU/ALU.v CPU/ALU_RegFile_Datapath.v CPU/BranchCondition.v CPU/FlagRegister.v CPU/InstructionDecoder.v CPU/InstructionRegister.v CPU/ProgramCounter.v CPU/RegisterFile.v CPU/bram.v CPU/traffic_io.v} {
    set_global_assignment -name VERILOG_FILE [file join $cpu_jtag_root $file_name]
}
set_global_assignment -name SDC_FILE [file join $cpu_jtag_root integration/cpu_jtag.sdc]
set_global_assignment -name MISC_FILE [file join $cpu_jtag_root CPU/traffic_firmware.hex]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {*}
